{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "kopiur-pvc",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "populate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "onMissingSnapshot": { "type": "string", "enum": ["Continue", "Fail"] },
        "waitTimeout": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "asOf": { "type": "string" },
        "credentialProjection": { "type": "boolean" },
        "mover": { "type": "object" },
        "sourcePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" }
          }
        },
        "extraSpec": { "type": "object" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["Repository", "ClusterRepository"] },
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string" }
          }
        },
        "copyMethod": { "type": "string", "enum": ["Snapshot", "Clone", "Direct"] },
        "volumeSnapshotClassName": { "type": "string" },
        "readOnly": { "type": "boolean" },
        "acknowledgeLiveMutation": { "type": "boolean" },
        "inheritSecurityContextFrom": { "type": "object" },
        "compression": { "type": "object" },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keepLatest": { "type": "integer", "minimum": 0 },
            "keepHourly": { "type": "integer", "minimum": 0 },
            "keepDaily": { "type": "integer", "minimum": 0 },
            "keepWeekly": { "type": "integer", "minimum": 0 },
            "keepMonthly": { "type": "integer", "minimum": 0 },
            "keepAnnual": { "type": "integer", "minimum": 0 }
          }
        },
        "mover": { "type": "object" },
        "errorHandling": { "type": "object" },
        "verification": { "type": "object" },
        "credentialProjection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "suspend": { "type": "boolean" },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cron": { "type": "string" },
            "jitter": { "type": "string" },
            "runOnCreate": { "type": "boolean" },
            "timezone": { "type": "string" },
            "suspend": { "type": "boolean" },
            "concurrencyPolicy": { "type": "string", "enum": ["Forbid", "Allow", "Replace"] },
            "startingDeadlineSeconds": { "type": ["integer", "null"], "minimum": 0 },
            "extraSpec": { "type": "object" }
          }
        },
        "extraSpec": { "type": "object" }
      }
    }
  },
  "properties": {
    "namespaceOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "uid": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Shorthand: adds mover.securityContext.runAsUser (+ runAsGroup/fsGroup, defaulting to `gid` or to this same value) to both the SnapshotPolicy and the Restore mover specs. Root (0) isn't supported by this shortcut -- set backup.mover/populate.mover directly for that."
    },
    "gid": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Shorthand: adds mover.securityContext.runAsGroup + mover.podSecurityContext.fsGroup (defaulting `uid`'s runAsUser to this value too, if `uid` is unset) to both the SnapshotPolicy and the Restore mover specs."
    },

    "persistence": {
      "type": "object",
      "minProperties": 1,
      "description": "One PVC per entry, keyed by PVC name (bjw-s-labs app-template / TrueCharts persistence naming). Required — at least one entry. populate/backup here sparse-override the top-level populate:/backup: defaults.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "if": {
          "properties": { "existingClaim": { "const": true } },
          "required": ["existingClaim"]
        },
        "then": {},
        "else": { "required": ["size"] },
        "properties": {
          "enabled": { "type": "boolean" },
          "existingClaim": {
            "type": "boolean",
            "description": "This entry's key is the name of a PVC that already exists and isn't created/managed by this chart (`size`/`storageClass`/`accessMode`/... are ignored). The Restore/SnapshotPolicy/SnapshotSchedule still render. The Restore stays a passive dataSourceRef populator -- inert on this (presumably already-Bound) PVC by design; it only acts if some future PVC's dataSourceRef claims it."
          },
          "size": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$"
          },
          "storageClass": { "type": "string" },
          "accessMode": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          },
          "volumeMode": { "type": "string", "enum": ["Filesystem", "Block"] },
          "retain": { "type": "boolean" },
          "uid": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Per-entry override of the top-level `uid` shorthand -- same effect, scoped to this entry only."
          },
          "gid": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Per-entry override of the top-level `gid` shorthand -- same effect, scoped to this entry only."
          },
          "labels": { "type": "object" },
          "annotations": { "type": "object" },
          "extraSpec": { "type": "object" },
          "populate": { "$ref": "#/definitions/populate" },
          "backup": { "$ref": "#/definitions/backup" }
        }
      }
    },

    "populate": {
      "allOf": [{ "$ref": "#/definitions/populate" }],
      "required": ["enabled", "onMissingSnapshot"]
    },
    "backup": {
      "allOf": [{ "$ref": "#/definitions/backup" }],
      "required": ["enabled", "repository", "copyMethod", "readOnly"]
    },

    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "syncWaves": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backup": { "type": "string", "pattern": "^-?[0-9]+$" },
            "restore": { "type": "string", "pattern": "^-?[0-9]+$" },
            "pvc": { "type": "string", "pattern": "^-?[0-9]+$" }
          }
        },
        "protectPvcFromDeletion": { "type": "boolean" }
      }
    }
  },
  "required": ["persistence", "populate", "backup"]
}
